<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessCoach.Views.Client.ClientDashboardPage"
             Title="FitnessCoach - Мій кабінет">

    <Grid RowDefinitions="auto,*,auto" ColumnDefinitions="*">

        <!-- Заголовок -->
        <Frame Grid.Row="0" Grid.Column="0"
               BackgroundColor="#2196F3"
               Padding="15"
               CornerRadius="0">
            <HorizontalStackLayout Spacing="15">
                <Frame WidthRequest="50" 
                       HeightRequest="50" 
                       CornerRadius="25"
                       BackgroundColor="White"
                       Padding="0"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label Text="МК"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2196F3"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Марія Ковальчук"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    <Label Text="Тренер: Олександр К."
                           TextColor="#E0E0E0"
                           FontSize="12"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <!-- Основний контент -->
        <ScrollView Grid.Row="1" Grid.Column="0" Padding="20">
            <VerticalStackLayout Spacing="25">

                <!-- Мої цілі -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout>
                            <Label Text="🎯 Мої цілі"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            <Label Text="(2/3)"
                                   FontSize="14"
                                   TextColor="#757575"
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" 
                              ColumnSpacing="15" RowSpacing="15">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="#E8F5E9"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="➖ 5 кг"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Вага"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                    <ProgressBar Progress="0.7"
                                                 ProgressColor="#2E7D32"
                                                 HeightRequest="8"
                                                 Margin="0,5,0,0"/>
                                    <Label Text="70%"
                                           FontSize="10"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="#E3F2FD"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="🏋️ 12 вправ"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Сила"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                    <ProgressBar Progress="0.9"
                                                 ProgressColor="#2196F3"
                                                 HeightRequest="8"
                                                 Margin="0,5,0,0"/>
                                    <Label Text="90%"
                                           FontSize="10"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="#FFF3E0"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="🏃 10 км"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Витривалість"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                    <ProgressBar Progress="0.4"
                                                 ProgressColor="#FF9800"
                                                 HeightRequest="8"
                                                 Margin="0,5,0,0"/>
                                    <Label Text="40%"
                                           FontSize="10"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="#FCE4EC"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="➕ Нова"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           TextColor="#757575"/>
                                    <Label Text="Ціль"
                                           FontSize="12"
                                           HorizontalOptions="Center"
                                           TextColor="#757575"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Наступне тренування -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="⏰ Наступне тренування"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <Frame Padding="15" 
                               CornerRadius="10" 
                               BackgroundColor="#E8F5E9"
                               BorderColor="#2E7D32">
                            <HorizontalStackLayout Spacing="15">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="СЬОГОДНІ"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32"/>
                                    <Label Text="14:00 - 15:30"
                                           FontSize="18"
                                           FontAttributes="Bold"/>
                                    <Label Text="Силове тренування"
                                           FontSize="14"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="5" 
                                                     HorizontalOptions="EndAndExpand">
                                    <Label Text="Тренер:"
                                           FontSize="11"
                                           TextColor="#757575"/>
                                    <Label Text="Олександр К."
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                    <Button Text="Детальніше ➔"
                                            BackgroundColor="Transparent"
                                            TextColor="#2E7D32"
                                            BorderColor="#2E7D32"
                                            BorderWidth="1"
                                            CornerRadius="5"
                                            HeightRequest="30"
                                            FontSize="12"
                                            HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Мої тренування -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout>
                            <Label Text="📋 Мої тренування"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            <Label Text="(тиждень)"
                                   FontSize="14"
                                   TextColor="#757575"
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>

                        <!-- Дні тижня -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" 
                              ColumnSpacing="5">
                            <Frame Grid.Column="0" Padding="8" CornerRadius="5" BackgroundColor="#2196F3">
                                <Label Text="ПН"
                                       TextColor="White"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="1" Padding="8" CornerRadius="5" BackgroundColor="#F5F5F5">
                                <Label Text="ВТ"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="2" Padding="8" CornerRadius="5" BackgroundColor="#F5F5F5">
                                <Label Text="СР"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="3" Padding="8" CornerRadius="5" BackgroundColor="#F5F5F5">
                                <Label Text="ЧТ"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="4" Padding="8" CornerRadius="5" BackgroundColor="#F5F5F5">
                                <Label Text="ПТ"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="5" Padding="8" CornerRadius="5" BackgroundColor="#2E7D32">
                                <Label Text="СБ"
                                       TextColor="White"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="6" Padding="8" CornerRadius="5" BackgroundColor="#F5F5F5">
                                <Label Text="НД"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </Frame>
                        </Grid>

                        <!-- Список тренувань -->
                        <VerticalStackLayout Spacing="10">

                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="🏋️ Силове тренування"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Сьогодні | 14:00-15:30"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="💪 8 вправ"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="⏱ 90 хв"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="🔥"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="🧘 Йога та розтяжка"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Завтра | 10:00-11:00"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="✨ Гнучкість"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="⏱ 60 хв"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="😌"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="🏃 Кардіо тренування"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Понеділок | 16:00-17:00"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="❤️ Витривалість"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="⏱ 60 хв"
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="⚡"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нижня панель навігації -->
        <Grid Grid.Row="2" Grid.Column="0"
              BackgroundColor="White"
              Padding="10"
              RowSpacing="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Label Text="🏠"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Головна"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="📅"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Розклад"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Центральна кнопка -->
            <Button Grid.Column="2"
                    Text="🏋️"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,-10,0,0"/>

            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <Label Text="📊"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Прогрес"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                <Label Text="👤"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Профіль"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>