<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessCoach.Views.Trainer.TrainerDashboardPage"
             Title="FitnessCoach - Панель тренера">

    <Grid RowDefinitions="auto,*,auto" ColumnDefinitions="*">

        <!-- Заголовок -->
        <Frame Grid.Row="0" Grid.Column="0"
               BackgroundColor="#2E7D32"
               Padding="15"
               CornerRadius="0">
            <HorizontalStackLayout Spacing="15">
                <Label Text="👨‍🏫"
                       FontSize="28"
                       VerticalOptions="Center"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Олександр Коваленко"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    <Label Text="Професійний фітнес-тренер"
                           TextColor="#E0E0E0"
                           FontSize="12"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <!-- Основний контент -->
        <ScrollView Grid.Row="1" Grid.Column="0" Padding="20">
            <VerticalStackLayout Spacing="25">

                <!-- Статистика -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="📊 Статистика за сьогодні"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" 
                              ColumnSpacing="15" RowSpacing="15">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="#E8F5E9"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="8"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Клієнтів"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="#E3F2FD"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="12"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Тренувань"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="2"
                                   BackgroundColor="#FFF3E0"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="3"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Нових"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="#FCE4EC"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="95%"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Відвідування"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="#F3E5F5"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="₴8,500"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Доход"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="2"
                                   BackgroundColor="#E0F2F1"
                                   Padding="15"
                                   CornerRadius="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="4.8"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Рейтинг"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Швидкі дії -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="⚡ Швидкі дії"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" 
                              ColumnSpacing="15" RowSpacing="15">

                            <Button Grid.Row="0" Grid.Column="0"
                                    Text="➕ Додати клієнта"
                                    BackgroundColor="#2E7D32"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="50"/>

                            <Button Grid.Row="0" Grid.Column="1"
                                    Text="📅 Розклад"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="50"/>

                            <Button Grid.Row="1" Grid.Column="0"
                                    Text="📊 Статистика"
                                    BackgroundColor="#FF9800"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="50"/>

                            <Button Grid.Row="1" Grid.Column="1"
                                    Text="💬 Повідомлення"
                                    BackgroundColor="#9C27B0"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="50"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Останні клієнти -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout>
                            <Label Text="👥 Останні клієнти"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            <Label Text="(8)"
                                   FontSize="14"
                                   TextColor="#757575"
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>

                        <!-- Список клієнтів -->
                        <VerticalStackLayout Spacing="12">

                            <!-- Клієнт 1 -->
                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <Frame WidthRequest="50" 
                                           HeightRequest="50" 
                                           CornerRadius="25"
                                           BackgroundColor="#E3F2FD"
                                           Padding="0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label Text="МК"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Марія Ковальчук"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Силове тренування | 14:00"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="💪 Прогрес: "
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="+3 кг"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#2E7D32"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="🔥"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- Клієнт 2 -->
                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <Frame WidthRequest="50" 
                                           HeightRequest="50" 
                                           CornerRadius="25"
                                           BackgroundColor="#FFF3E0"
                                           Padding="0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label Text="АП"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Андрій Петренко"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Кардіо | 15:30"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="🏃 Витривалість: "
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="+15%"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#2196F3"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="✅"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- Клієнт 3 -->
                            <Frame Padding="15" CornerRadius="10" BackgroundColor="#F5F5F5">
                                <HorizontalStackLayout Spacing="15">
                                    <Frame WidthRequest="50" 
                                           HeightRequest="50" 
                                           CornerRadius="25"
                                           BackgroundColor="#FCE4EC"
                                           Padding="0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label Text="ОН"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Оксана Новак"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="Йога | 17:00"
                                               FontSize="12"
                                               TextColor="#757575"/>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="🧘 Гнучкість: "
                                                   FontSize="11"
                                                   TextColor="#757575"/>
                                            <Label Text="+8%"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#9C27B0"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Text="⚠️"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нижня панель навігації -->
        <Grid Grid.Row="2" Grid.Column="0"
              BackgroundColor="White"
              Padding="10"
              RowSpacing="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Label Text="🏠"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Головна"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="👥"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Клієнти"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Центральна кнопка -->
            <Button Grid.Column="2"
                    Text="➕"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,-10,0,0"/>

            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <Label Text="📅"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Розклад"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                <Label Text="⚙️"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label Text="Налаштування"
                       FontSize="10"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>